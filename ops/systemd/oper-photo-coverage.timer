[Unit]
Description=Check photo coverage every 30 minutes

[Timer]
# Hourly, not every 30 min. Coverage moves on the CRAWL's cadence (hours), so a
# 30-minute probe re-measured a number that had not moved, at 2-4s of database
# time each run. Detection latency of an hour is proportionate to a metric that
# changes over hours.
OnBootSec=15min
OnUnitActiveSec=1h
Persistent=true
Unit=oper-photo-coverage.service

[Install]
WantedBy=timers.target

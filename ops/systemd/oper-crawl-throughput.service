[Unit]
Description=OnePercent — alert when confirmation throughput falls below what the SLO needs
After=oper-postgres.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/onepercent
EnvironmentFile=/etc/oper.env
ExecStart=/opt/onepercent/ops/monitoring/crawl-throughput.sh
MemoryHigh=64M
MemoryMax=96M

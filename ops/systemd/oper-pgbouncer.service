[Unit]
Description=OnePercent PgBouncer Transaction Pooler
After=oper-postgres.service
Requires=oper-postgres.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=root
WorkingDirectory=/opt/onepercent/ops/pgbouncer
EnvironmentFile=/etc/oper.env
ExecStart=/usr/bin/pgbouncer pgbouncer.ini
Restart=on-failure
RestartSec=5
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target

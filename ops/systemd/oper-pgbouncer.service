[Unit]
Description=OnePercent PgBouncer Transaction Pooler
After=oper-postgres.service
Requires=oper-postgres.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=root
WorkingDirectory=/opt/onepercent/ops/pgbouncer
EnvironmentFile=/etc/oper.env
# Debian/Ubuntu install the binary at /usr/sbin/pgbouncer — /usr/bin/pgbouncer
# does not exist and gave status=203/EXEC. (Type=simple permits exactly one
# ExecStart, so this must be the correct absolute path, not a fallback list.)
ExecStart=/usr/sbin/pgbouncer pgbouncer.ini
Restart=on-failure
RestartSec=5
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target

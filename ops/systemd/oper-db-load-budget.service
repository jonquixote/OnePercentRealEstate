[Unit]
Description=OnePercent — DB load budget check (no query may silently eat the database)
After=oper-postgres.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/onepercent
EnvironmentFile=/etc/oper.env
ExecStart=/opt/onepercent/ops/monitoring/db-load-budget.sh
MemoryHigh=96M
MemoryMax=128M

[Unit]
Description=OnePercent pg_tileserv (MVT vector tiles)
After=oper-postgres.service
Requires=oper-postgres.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/oper.env
EnvironmentFile=-/etc/oper-role-tileserv.env
WorkingDirectory=/usr/local/share/pg_tileserv
# Loopback only — nginx proxies /tiles to it. pg_tileserv defaults to all
# interfaces, exposing an unauthenticated tile API directly (found 2026-07-31).
Environment=TS_HTTPHOST=127.0.0.1
ExecStart=/usr/local/bin/pg_tileserv
Restart=on-failure
RestartSec=5
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target

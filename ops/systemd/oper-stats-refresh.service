[Unit]
Description=OnePercent — refresh precomputed homepage stats (stats_summary)
After=oper-app.service oper-postgres.service
Wants=oper-app.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/onepercent
EnvironmentFile=/etc/oper.env
# Keeps the ~18s-per-strategy aggregate OUT of user requests. Fails loudly in
# the journal; /api/stats keeps serving the last good value regardless (SWR).
ExecStart=/bin/bash -c 'curl -sS -f -m 280 -X POST -H "Authorization: Bearer $ADMIN_API_KEY" http://127.0.0.1:3001/api/internal/refresh-stats'
MemoryHigh=96M
MemoryMax=128M
